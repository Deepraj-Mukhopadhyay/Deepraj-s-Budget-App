# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/budget_app
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/budget_app?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/budget_app

# JWT Secret Key
JWT_SECRET=super_secret_budget_app_jwt_key_2026_change_in_production
JWT_EXPIRE=30d

# CORS Allowed Origin (defaults to * or specific frontend URL)
CORS_ORIGIN=*
